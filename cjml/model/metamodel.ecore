<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="cjmlmetamodel" nsURI="http://cjml.no/metamodel" nsPrefix="cjml">
  <eClassifiers xsi:type="ecore:EClass" name="PlannedJourney" eSuperTypes="#//CustomerJourney">
    <eStructuralFeatures xsi:type="ecore:EReference" name="plannedTouchpoints" lowerBound="2"
        upperBound="-1" eType="#//PlannedTouchpoint"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="comment" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ActualJourney" eSuperTypes="#//CustomerJourney">
    <eStructuralFeatures xsi:type="ecore:EReference" name="actualTouchpoints" lowerBound="2"
        upperBound="-1" eType="#//ActualTouchpoint"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="journeyCompliance" eType="#//PlannedJourney"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="journeyExperience" eType="#//EndUserExperience"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="journeyStatus" eType="#//status"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="plannedReference" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="contentCompliance" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="sequenceCompliance" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timingCompliance" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="comment" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CustomerJourney">
    <eStructuralFeatures xsi:type="ecore:EReference" name="journeyOperators" upperBound="-1"
        eType="#//JourneyOperator"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="journeyPhases" upperBound="-1"
        eType="#//JourneyPhase"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="endUsers" lowerBound="1"
        upperBound="-1" eType="#//EndUser"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="serviceProviders" lowerBound="1"
        upperBound="-1" eType="#//ServiceProvider"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="externals" upperBound="-1"
        eType="#//External"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="journeyID" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="journeyTitle" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="journeyShortSummary" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="journeyLongSummary" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Touchpoint">
    <eStructuralFeatures xsi:type="ecore:EReference" name="systems" upperBound="-1"
        eType="#//BackendSystem"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="objects" upperBound="-1"
        eType="#//Object"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="belongsTo" eType="#//JourneyPhase"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="touchpointID" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="uncertainty" upperBound="4"
        eType="#//uncertaintyValues"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PlannedTouchpoint" eSuperTypes="#//Touchpoint">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="deltaTime" upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="touchpointDuration" upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="comment" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ActualTouchpoint" eSuperTypes="#//Touchpoint">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timeStarted" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timeCompleted" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="touchpointCompliance" eType="#//PlannedTouchpoint"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="touchpointExperience" eType="#//EndUserExperience"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PlannedAction" eSuperTypes="#//PlannedTouchpoint">
    <eStructuralFeatures xsi:type="ecore:EReference" name="initiator" lowerBound="1"
        eType="#//Initiator"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PlannedCommunicationPoint" eSuperTypes="#//PlannedTouchpoint">
    <eStructuralFeatures xsi:type="ecore:EReference" name="initiator" lowerBound="1"
        eType="#//Initiator"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="receiver" lowerBound="1"
        eType="#//Receiver"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="channel" lowerBound="1"
        eType="#//Channel"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="message" eType="#//Message"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="touchpointCategory" eType="#//Classification"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ActualCommunicationPoint" eSuperTypes="#//ActualTouchpoint">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timeOriginated" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timeAvailable" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timeConsumed" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="initiator" lowerBound="1"
        eType="#//Initiator"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="receiver" lowerBound="1"
        eType="#//Receiver"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="channel" lowerBound="1"
        eType="#//Channel"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="message" eType="#//Message"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="compliance" eType="#//complianceValues"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="comment" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="touchpointCategory" eType="#//Classification"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="ActualAction" eSuperTypes="#//ActualTouchpoint">
    <eStructuralFeatures xsi:type="ecore:EReference" name="initiator" lowerBound="1"
        eType="#//Initiator"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="compliance" eType="#//complianceValues"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="comment" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="JourneyOperator">
    <eStructuralFeatures xsi:type="ecore:EReference" name="belongsTo" eType="#//JourneyPhase"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="operatorID" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Concurrency" eSuperTypes="#//JourneyOperator">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="concurrencypaths" upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Decision" eSuperTypes="#//JourneyOperator">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="decisionPaths" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="condition" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="decisionMaker" eType="#//Actor"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="EndUserExperience">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="experienceDescription"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="experienceRating" lowerBound="1"
        upperBound="5" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="BackendSystem">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="systemID" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="systemName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="systemDescription" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Object">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="objectID" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="objectName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
