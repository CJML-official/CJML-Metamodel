    <eLiterals name="Patient’s personal network" value="2"/>
    <eLiterals name="Digital health system" value="3"/>
    <eLiterals name="Digital system – general" value="4"/>
    <eLiterals name="Patient organization and auxiliary service" value="5"/>
    <eLiterals name="Employer" value="6"/>
    <eLiterals name="Welfare service and social care" value="7"/>
    <eLiterals name="Health authority" value="8"/>
    <eLiterals name="Health registry and quality system" value="9"/>
    <eLiterals name="Other" value="10"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Classification">
    <eLiterals name="coreEncounter"/>
    <eLiterals name="supportiveEncounter" value="1"/>
    <eLiterals name="confirmation" value="2"/>
    <eLiterals name="statusUpdate" value="3"/>
    <eLiterals name="notification" value="4"/>
