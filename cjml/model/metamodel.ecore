    <eLiterals name="faceToFace" value="6"/>
    <eLiterals name="internetViaPC" value="7"/>
    <eLiterals name="internetViaSmartPhone" value="8"/>
    <eLiterals name="internetViaTablet" value="9"/>
    <eLiterals name="appOnPC" value="10"/>
    <eLiterals name="appOnSmartPhone" value="11"/>
    <eLiterals name="appOnTablet" value="12"/>
    <eLiterals name="internet" value="13"/>
    <eLiterals name="selfServiceMachine" value="14"/>
    <eLiterals name="letter" value="15"/>
    <eLiterals name="packageDelivery" value="16"/>
    <eLiterals name="faxMessage" value="17"/>
    <eLiterals name="shopCounter" value="18"/>
    <eLiterals name="serviceDesk" value="19"/>
    <eLiterals name="paymentChannel" value="20"/>
    <eLiterals name="unknownChannel" value="21"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="uncertaintyValues">
    <eLiterals name="uncertainOccurrence"/>
    <eLiterals name="uncertainNoOfOccurrence" value="1"/>
    <eLiterals name="uncertainChannel" value="2"/>
    <eLiterals name="uncertainInitiator" value="3"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="comTypes">
    <eLiterals name="unicast"/>
    <eLiterals name="multicast" value="1"/>
    <eLiterals name="broadcast" value="2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="providerTypes">
    <eLiterals name="HealthcareServiceProvider"/>
    <eLiterals name="PublicServiceProvider" value="1"/>
    <eLiterals name="CommercialServiceProvider" value="2"/>
    <eLiterals name="PrivateServiceProvider" value="3"/>
    <eLiterals name="NonProfitServiceProvider" value="4"/>
    <eLiterals name="VoluntaryServiceProvider" value="5"/>
    <eLiterals name="CommunityServiceProvider" value="6"/>
    <eLiterals name="OtherServiceProvide" value="7"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Role">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="roleName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="roleDescription" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="HealthCareServiceProvider" eSuperTypes="#//ServiceProvider">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="HealthCareServiceProviderType"
