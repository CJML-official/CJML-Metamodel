<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="sosym" nsURI="sosym" nsPrefix="sosym">
  <eClassifiers xsi:type="ecore:EClass" name="ServiceProcess">
    <eStructuralFeatures xsi:type="ecore:EReference" name="groups" lowerBound="1"
        upperBound="-1" eType="#//JourneyGroup"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="JourneyGroup">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="groupID" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="groupDescription" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="numberofJourneys" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="journeys" lowerBound="1"
        upperBound="-1" eType="#//CustomerJourney"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="decisionPaths" upperBound="-1"
        eType="#//Decision"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CustomerJourney">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="journeyID" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="journeyTitle" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="journeyShortSummary" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="journeyLongSummary" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="elements" lowerBound="2"
        upperBound="-1" eType="#//CustomerJourneyElement"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="phases" upperBound="-1"
        eType="#//JourneyPhase"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="concurrentPaths" upperBound="-1"
        eType="#//Concurrency"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="endUsers" lowerBound="1"
        upperBound="-1" eType="#//EndUser"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="providers" lowerBound="1"
        upperBound="-1" eType="#//ServiceProvider"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="externals" upperBound="-1"
        eType="#//External"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="PlannedJourney" eSuperTypes="#//CustomerJourney"/>
  <eClassifiers xsi:type="ecore:EClass" name="ActualJourney" eSuperTypes="#//CustomerJourney">
    <eStructuralFeatures xsi:type="ecore:EReference" name="journeyCompliance" eType="#//PlannedJourney"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="journeyStatus" eType="#//Status"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="contentCompliance" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="sequenceCompliance" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="endUserExperience" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="endUserExperienceRating"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Status">
    <eLiterals name="inProgress"/>
    <eLiterals name="completed" value="1"/>
    <eLiterals name="aborted" value="2"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Touchpoint" eSuperTypes="#//CustomerJourneyElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="touchpointID" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="compliance" eType="#//ComplianceValues"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="uncertainty" eType="#//UncertaintyValues"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="endUserExperience" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="endUserExperienceRating"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timeStarted" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timeCompleted" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="comment" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="objects" upperBound="-1"
        eType="#//Object"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="systems" upperBound="-1"
        eType="#//BackendSystem"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CustomerJourneyElement">
    <eStructuralFeatures xsi:type="ecore:EReference" name="belongsTo" eType="#//JourneyPhase"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="JourneyPhase">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="phaseName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="phaseDescription" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="JourneyOperator">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="operatorID" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="belongsTo" eType="#//JourneyPhase"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Decision" eSuperTypes="#//JourneyOperator">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="decisionPaths" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="condition" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="decisionMaker" eType="#//Actor"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Concurrency" eSuperTypes="#//JourneyOperator">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="concurrencyPaths" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Actor">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="actorID" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="actorName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="actorDescription" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="isVirtual" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="External" eSuperTypes="#//Actor"/>
  <eClassifiers xsi:type="ecore:EClass" name="ServiceProvider" eSuperTypes="#//Actor">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="companyName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="department" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="EndUser" eSuperTypes="#//Actor">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="endUserType" eType="#//EUTypes"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="EUTypes">
    <eLiterals name="customer"/>
    <eLiterals name="user" value="1"/>
    <eLiterals name="citizen" value="2"/>
    <eLiterals name="patient" value="3"/>
    <eLiterals name="employee" value="4"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="ComplianceValues">
    <eLiterals name="planned"/>
    <eLiterals name="adhoc" value="1"/>
    <eLiterals name="missing" value="2"/>
    <eLiterals name="failing" value="3"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="UncertaintyValues">
    <eLiterals name="uncertainOccurrence"/>
    <eLiterals name="uncertainNoOfOccurrence" value="1"/>
    <eLiterals name="uncertainChannel" value="2"/>
    <eLiterals name="uncertainInitiator" value="3"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Action" eSuperTypes="#//Touchpoint">
    <eStructuralFeatures xsi:type="ecore:EReference" name="hasInitiator" lowerBound="1"
        eType="#//Initiator"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="CommunicationPoint" eSuperTypes="#//Touchpoint">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timeOriginated" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timeReceived" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timeConsumed" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDate"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="hasInitiator" lowerBound="1"
        eType="#//Initiator"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="hasReceiver" lowerBound="1"
        eType="#//Receiver"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="hasChannel" lowerBound="1"
        eType="#//Channel"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="hasMessage" lowerBound="1"
        eType="#//Message"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Object">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="objectID" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="objectName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="isVirtual" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="objectDescription" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="BackendSystem">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="systemID" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="systemName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="systemDescription" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Initiator">
    <eStructuralFeatures xsi:type="ecore:EReference" name="refersTo" lowerBound="1"
        eType="#//Actor"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="initiatorLabel" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Receiver">
    <eStructuralFeatures xsi:type="ecore:EReference" name="refersTo" lowerBound="1"
        eType="#//Actor"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="receiverLabel" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Channel">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="channelName" eType="#//Channels"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Message">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="keyMessage" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="messageContent" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Channels">
    <eLiterals name="telephone"/>
    <eLiterals name="sms" value="1"/>
    <eLiterals name="faceToFace" value="2"/>
    <eLiterals name="internet" value="3"/>
    <eLiterals name="email" value="4"/>
  </eClassifiers>
</ecore:EPackage>
